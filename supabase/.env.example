# Local Supabase dev — copy to .env and fill in. Never commit the real one.
# Used by:  supabase functions serve chat --env-file .env

# Your project ref + keys (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LLM provider (any OpenAI-compatible /chat/completions endpoint)
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=YOUR_LLM_KEY
LLM_MODEL=gemini-3.5-flash-lite

# Play purchase verification — paste the ENTIRE service-account JSON on one line.
# Same file as the Firebase version used; nothing changes on the Play side.
PLAY_SERVICE_ACCOUNT={"type":"service_account", "...": "..."}
